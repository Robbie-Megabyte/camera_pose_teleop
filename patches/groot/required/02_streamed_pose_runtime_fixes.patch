-        result.frame_offset_adjustment = did_catchup ? 0 : window_shift;
+
+        // Normal window shifting subtracts window_shift from current_frame,
+        // preserving the same global playback position.  For live streaming,
+        // if playback is more than SOFT_TARGET_GAP_FRAMES behind the newest
+        // received reference, subtract one frame less.  The caller therefore
+        // advances by exactly one additional 50 Hz reference frame without
+        // entering the hard catch-up path, resetting current_frame to zero,
+        // or reinitializing heading.
+        int soft_catchup_frames = 0;
+
+        if (!did_catchup && frame_step > 0 && window_shift > 0) {
+            const int live_gap_frames =
+                std::max(
+                    0,
+                    (incoming_frame_end - global_playback_frame)
+                        / frame_step
+                );
+
+            if (live_gap_frames > SOFT_TARGET_GAP_FRAMES) {
+                soft_catchup_frames =
+                    std::min(
+                        SOFT_CATCHUP_STEP_FRAMES,
+                        window_shift
+                    );
+
+                if constexpr (DEBUG_LOGGING) {
+                    std::cout
+                        << "[StreamedMotionMerger] SOFT-CATCH-UP: "
+                        << "live_gap_frames=" << live_gap_frames
+                        << ", extra_advance_frames="
+                        << soft_catchup_frames
+                        << std::endl;
+                }
+            }
+        }
+
+        result.frame_offset_adjustment =
+            did_catchup
+                ? 0
+                : (window_shift - soft_catchup_frames);
+
         result.did_catchup_reset = did_catchup;
         result.frame_step = frame_step;
         result.protocol_version = data.protocol_version;
