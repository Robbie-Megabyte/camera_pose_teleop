# Camera Pose Teleop local configuration
#
# Copy this file to:
#   configs/local.env
#
# local.env is ignored by Git.

# Existing source checkouts.
# Leave blank when using the future managed .deps/ setup.
GVHMR_ROOT=
GENMO_ROOT=
SONIC_ROOT=
TORCH2TRT_ROOT=

# Python/runtime environment
POSE_PYTHON=

# TensorRT compatibility paths
TRT8_PYTHON_DIR=
TRT8_LIB_DIR=
TRT10_LIB_DIR=

# Camera
# Leave blank until camera discovery/selection is complete.
CAMERA_DEVICE=
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_FORMAT=mjpeg

# Generated/downloaded acceleration artifacts
VITPOSE_TRT_STATE=
HMR2_ONNX=
HMR2_TRT_CACHE=

# SONIC stream
SONIC_POSE_PORT=5556
SONIC_POSE_TOPIC=pose
SONIC_EMA_WEIGHT=0.0

# Local preview streams
RAW_PREVIEW_PORT=5600
KEYPOINT_PREVIEW_PORT=5601
