+    # Generate SMPL vertices in bounded batches so GPU memory usage does
+    # not grow with the duration of the recording.
+    smpl_params_incam = pred["smpl_params_incam"]
+    num_frames = next(
+        value.shape[0]
+        for value in smpl_params_incam.values()
+        if torch.is_tensor(value) and value.ndim > 0
+    )
+    batch_size = 64
+    pred_c_verts_batches = []
+
+    with torch.inference_mode():
+        for start in tqdm(
+            range(0, num_frames, batch_size),
+            desc="SMPL-X Incam Vertices",
+        ):
+            end = min(start + batch_size, num_frames)
+
+            batch_params = {
+                key: (
+                    value[start:end]
+                    if torch.is_tensor(value)
+                    and value.ndim > 0
+                    and value.shape[0] == num_frames
+                    else value
+                )
+                for key, value in smpl_params_incam.items()
+            }
+
+            smplx_out = smplx(**to_cuda(batch_params))
+            batch_verts = torch.stack(
+                [torch.matmul(smplx2smpl, vertex) for vertex in smplx_out.vertices]
+            )
+
+            pred_c_verts_batches.append(batch_verts.detach().cpu())
+
+            del batch_params, smplx_out, batch_verts
+
+    pred_c_verts = torch.cat(pred_c_verts_batches, dim=0)
+    del pred_c_verts_batches
