+    /// below by bounded soft catch-up without resetting playback or heading.
     static constexpr int MAX_GAP_FRAMES = 200;
+
+    /// Desired maximum distance from playback to the newest live reference.
+    /// At the accepted 50 Hz Protocol-v1 rate, 25 frames = 0.5 seconds.
+    static constexpr int SOFT_TARGET_GAP_FRAMES = 25;
+
+    /// While above the soft target, consume at most one additional reference
